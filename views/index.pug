extends layout

block content
    section.hero
        div.hero__image(role="img", aria-label="The exterior of St Mary's Church in Edlington")
        div.hero__shade
        div.hero__content
            p.eyebrow Welcome to
            h1 St Mary's Edlington
            p.hero__lead A Catholic parish where faith is celebrated, community is cherished, and everyone is welcome.
            div.hero__actions
                a.button.button--primary(href="#service-times") View service times
                if globalData.mostRecentNewsletterLink
                    a.button.button--ghost(href=globalData.mostRecentNewsletterLink) Read the newsletter

    section.intro.section-shell
        div.intro__heading
            p.eyebrow Our parish
            h2 A place to belong
        div.intro__copy
            p We are a community in the Doncaster area, gathering to worship, receive the sacraments, share the Gospel, and support one another in following Jesus Christ.
            p Our church services are open to all. Whether you are a familiar face, returning after time away, or visiting for the first time, you are warmly invited.

    section#service-times.services-section
        div.section-shell
            div.section-heading
                div
                    p.eyebrow Worship with us
                    h2 Mass & service times
                p.section-heading__note Times can occasionally change. Please check the latest newsletter for seasonal updates.

            div.table-card
                table
                    caption.sr-only Mass and service times
                    thead
                        tr
                            th(scope="col") Service
                            th(scope="col") When
                            th(scope="col") Location
                    tbody
                        for service in data.serviceTimes
                            tr
                                td(data-label="Service")
                                    strong=service.service_type
                                td(data-label="When")
                                    +to-service-time(
                                        service.weekday,
                                        service.day,
                                        service.month,
                                        service.year,
                                        service.hours,
                                        service.minutes
                                    )
                                td(data-label="Location")=service.location_name

    section.parish-details.section-shell
        if data.parishPriest
            article.info-card.info-card--priest
                p.eyebrow Parish priest
                h2=data.parishPriest.full_name
                dl.contact-list
                    if data.parishPriest.landline
                        div
                            dt Presbytery
                            dd=data.parishPriest.landline
                    if data.parishPriest.mobile
                        div
                            dt Mobile
                            dd=data.parishPriest.mobile
                    if data.parishPriest.email
                        div
                            dt Email
                            dd
                                a(href="mailto:" + data.parishPriest.email)=data.parishPriest.email
                    if data.parishPriest.address_name
                        div
                            dt Post
                            dd=data.parishPriest.address_name

        article.info-card
            p.eyebrow Find us
            h2 Our churches
            div.location-list
                for location in data.locations
                    address
                        strong=location.house_name
                        span #{location.house_number} #{location.road_name}
                        span=location.town
                        if location.post_town
                            span=location.post_town
                        span=location.postcode

    section.gallery-section(aria-labelledby="gallery-title")
        div.section-shell
            div.section-heading
                div
                    p.eyebrow Life at St Mary's
                    h2#gallery-title Our church community
            div.photo-grid
                figure.photo-grid__large
                    img(src="/images/slideshows/st_marys/1.jpg", alt="Inside St Mary's Church", loading="lazy")
                figure
                    img(src="/images/slideshows/st_marys/2.jpg", alt="A view of the church community", loading="lazy")
                figure
                    img(src="/images/slideshows/st_marys/3.jpg", alt="Parish life at St Mary's", loading="lazy")
                figure
                    img(src="/images/slideshows/st_marys/4.jpg", alt="The church prepared for worship", loading="lazy")

    if isAdmin
        section.section-shell
            div.admin-notice
                strong Parish administration
                a(href="/admin") Open the admin area →
