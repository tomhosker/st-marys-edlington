mixin to-two-digit(number)
    if number > 9
        | #{number}
    else
        | 0#{number}

mixin to-time(hours, minutes)
    +to-two-digit(hours)
    |:
    +to-two-digit(minutes)

mixin weekday-numeral-to-name(numeral)
    - const weekdays = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
    if weekdays[numeral]
        | #{weekdays[numeral]}
    else
        | Date to be confirmed

mixin month-numeral-to-name(numeral)
    - const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    if months[numeral - 1]
        | #{months[numeral - 1]}
    else
        | Month to be confirmed

mixin to-day-month(day, month)
    +to-two-digit(day)
    | 
    +month-numeral-to-name(month)

mixin to-full-date(day, month, year)
    +to-day-month(day, month)
    |  #{year}

mixin to-service-time(weekday, day, month, year, hours, minutes)
    if weekday || weekday == 0
        | Every 
        +weekday-numeral-to-name(weekday)
    else
        +to-full-date(day, month, year)
    |  at
    | 
    +to-time(hours, minutes)

doctype html
html(lang="en")
    head
        meta(charset="utf-8")
        meta(name="viewport", content="width=device-width, initial-scale=1")
        meta(name="theme-color", content="#173f35")
        meta(name="description", content="St Mary's Roman Catholic Church in Edlington, Doncaster. Service times, parish news and community information.")
        title #{title} | St Mary's Edlington
        link(rel="icon", href="/favicon.ico")
        link(rel="stylesheet", href="/stylesheets/style.css")
    body
        a.skip-link(href="#main-content") Skip to main content

        header.site-header
            div.site-header__inner
                a.brand(href="/", aria-label="St Mary's Edlington home")
                    span.brand__mark(aria-hidden="true") ✦
                    span.brand__text
                        strong St Mary's
                        small Roman Catholic Church · Edlington

                nav.site-nav(aria-label="Main navigation")
                    a(href="/") Home
                    a(href="/#service-times") Service times
                    a(href="/youth/childrens-liturgies") Children & youth
                    a(href="/pilgrimages") Pilgrimages
                    if globalData.mostRecentNewsletterLink
                        a.nav-cta(href=globalData.mostRecentNewsletterLink) Latest newsletter
                    else
                        a.nav-cta(href="/newsletters") Newsletters

        main#main-content.site-main
            block content

        footer.site-footer
            div.site-footer__inner
                div
                    p.site-footer__name St Mary's Edlington
                    p A welcoming Roman Catholic community in Doncaster.
                nav.footer-nav(aria-label="Footer navigation")
                    a(href="/") Home
                    a(href="/pilgrimages") Pilgrimages
                    if loggedIn
                        a(href="/admin") Admin area
                        a(href="/logout") Log out
                    else
                        a(href="/logmein") Parish login
            div.liturgical-rule.liturgical-background(aria-hidden="true")

        script(src="/frontend_scripts/browserified/liturgical_colours.js", defer)
